{
  "name": "cloudflare-telegram-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",

  // Telegram integration storage
  "kv_namespaces": [
    {
      "binding": "TG",
      "id": "ad38fba38f3440a28a763a63c5b8e2af"
    }
  ],

  // Run scheduled tasks every 15 minutes
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
}
